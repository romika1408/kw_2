  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}
QFrame#controlPanel {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
}
QFrame#controlPanel QLabel, QFrame#controlPanel QGroupBox {
    background-color: transparent;
}
QLabel#titleLabel {
    font-size: 15pt;
    font-weight: bold;
    color: #ffffff;
}
QLabel#subtitleLabel {
    color: #8b949e;
}
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 14px;
    padding: 8px 6px 6px 6px;
    font-weight: bold;
    color: #58a6ff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}
QGroupBox QLabel {
    font-weight: normal;
    color: #c9d1d9;
}
QPushButton {
    background-color: #1f6feb;
    border: none;
    border-radius: 6px;
    padding: 6px;
    color: #ffffff;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #388bfd;
}
QPushButton:pressed {
    background-color: #1158c7;
}
QPushButton#emergencyButton {
    background-color: #da3633;
    font-size: 11pt;
    padding: 9px;
}
QPushButton#emergencyButton:hover {
    background-color: #f85149;
}
QPushButton#createButton, QPushButton#setBatteryButton {
    background-color: #238636;
}
QPushButton#createButton:hover, QPushButton#setBatteryButton:hover {
    background-color: #2ea043;
}
QSpinBox, QDoubleSpinBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px;
}
QProgressBar {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    text-align: center;
    min-height: 24px;
    font-weight: bold;
}
QProgressBar::chunk {
    border-radius: 5px;
    background-color: #2ea043;
}
QProgressBar[level=&quot;low&quot;]::chunk {
    background-color: #d29922;
}
QProgressBar[level=&quot;critical&quot;]::chunk {
    background-color: #da3633;
}
QLabel#statusValue {
    font-weight: bold;
    color: #8b949e;
}
QLabel#statusValue[flying=&quot;true&quot;] {
    color: #3fb950;
}
QLabel#logTitle {
    color: #8b949e;
    font-weight: bold;
}
QTextEdit#logView {
    background-color: #010409;
    border: 1px solid #30363d;
    border-radius: 8px;
    font-family: Consolas;
    font-size: 10pt;
}</string>
