  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}
QFrame#controlPanel {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
}
QFrame#controlPanel QLabel, QFrame#controlPanel QGroupBox, QTabWidget QWidget#windTab, QTabWidget QWidget#routeTab {
    background-color: transparent;
}
QLabel#titleLabel {
    font-size: 15pt;
    font-weight: bold;
    color: #ffffff;
}
QLabel#subtitleLabel {
    color: #8b949e;
}
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background-color: #0d1117;
    color: #8b949e;
    border: 1px solid #30363d;
    padding: 6px 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background-color: #1f6feb;
    color: #ffffff;
    font-weight: bold;
}
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 14px;
    padding: 8px 6px 6px 6px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}
QGroupBox#droneGroup { color: #58a6ff; }
QGroupBox#windGroup { color: #f0883e; }
QGroupBox#startGroup { color: #3fb950; }
QGroupBox#finishGroup { color: #f85149; }
QGroupBox#windResultGroup, QGroupBox#routeResultGroup { color: #e3b341; }
QGroupBox QLabel {
    font-weight: normal;
    color: #c9d1d9;
}
QLabel[result=&quot;true&quot;] {
    font-family: Consolas;
    font-weight: bold;
    color: #ffffff;
}
QLabel#checkValue {
    font-weight: bold;
    color: #f85149;
}
QLabel#checkValue[ok=&quot;true&quot;] {
    color: #3fb950;
}
QPushButton {
    background-color: #1f6feb;
    border: none;
    border-radius: 6px;
    padding: 9px;
    color: #ffffff;
    font-weight: bold;
    font-size: 11pt;
}
QPushButton:hover {
    background-color: #388bfd;
}
QPushButton:pressed {
    background-color: #1158c7;
}
QDoubleSpinBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px;
}</string>
